// Prisma Schema for Internal Marketplace & Warehouse Analytics
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String         @id @default(uuid())
  email     String         @unique
  password  String
  name      String
  role      String         @default("USER") // ADMIN, USER
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  stores    StoreSession[]
  notificationConfig NotificationConfig?
}

/// Konfigurasi kanal notifikasi per pengguna. Admin mengisi ini agar bisa mengirim
/// rencana kerja / hasil analisa ke pengguna. Nilai per-user: Discord memakai webhook URL
/// milik channel pengguna; Telegram memakai chat ID (token bot bersifat global di env
/// TELEGRAM_BOT_TOKEN). whatsappNumber disiapkan untuk kanal WhatsApp yang menyusul.
model NotificationConfig {
  id                String   @id @default(uuid())
  userId            String   @unique
  discordWebhookUrl String?
  telegramChatId    String?
  whatsappNumber    String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Jejak setiap upaya kirim notifikasi, supaya admin bisa melihat apa yang terkirim ke
/// siapa dan lewat kanal apa (berhasil atau gagal). Pesan disimpan agar bisa dibaca ulang.
model NotificationLog {
  id            String   @id @default(uuid())
  userId        String?
  recipientName String?
  channel       String   // discord | telegram | whatsapp
  subject       String?
  message       String
  status        String   // SENT | FAILED
  error         String?
  actorId       String?
  actorName     String?
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([channel, createdAt])
}

model StoreSession {
  id           String    @id @default(uuid())
  storeName    String
  storeId      String    @unique
  userId       String?
  cookieString String
  userAgent    String
  csrfToken    String?
  isActive     Boolean   @default(true)
  lastSyncedAt DateTime  @default(now())
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ShopeeProduct {
  id            String   @id @default(uuid())
  storeId       String
  shopeeItemId  String   @unique
  name          String
  sku           String
  price         Float
  stock         Int
  salesCount    Int      @default(0)
  views         Int      @default(0)
  addToCart     Int      @default(0)
  category      String   @default("Uncategorized")
  l2CategoryId  String?
  l3CategoryId  String?
  l2CategoryName String?
  l3CategoryName String?
  imageUrl      String?
  rating        Float    @default(0)
  unitCost      Float?
  unitAdCost    Float?
  shippingCost  Float?
  platformFeePercent Float?
  updatedAt     DateTime @updatedAt

  variations    ShopeeListingVariation[]

  @@index([storeId, category])
}

/// One sellable unit of a Shopee listing.
///
/// shopeeService already normalises `item.model_list` into per-variation
/// {id, name, sku, stock, soldCount}, but persistProducts discarded it. Two things
/// depend on keeping it:
///
///  - `ShopeeProduct.stock` is a single store-wide number, which is why reconciliation
///    had nothing meaningful to compare a per-warehouse stock figure against.
///  - `ShopeeProduct.sku` falls back to the Shopee item id when parent_sku is empty,
///    which is exactly when the real SKU lives at variation level. Warehouse-shaped
///    SKUs are most likely to appear here.
model ShopeeListingVariation {
  id            String   @id @default(uuid())
  storeId       String
  shopeeItemId  String
  shopeeModelId String
  name          String   @default("")
  variationSku  String   @default("")
  stock         Int      @default(0)
  soldCount     Int      @default(0)
  dataAsOf      DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product ShopeeProduct @relation(fields: [shopeeItemId], references: [shopeeItemId], onDelete: Cascade)

  @@unique([shopeeItemId, shopeeModelId])
  @@index([variationSku])
  @@index([storeId])
}

model ShopeeOrderSummary {
  id                String   @id @default(uuid())
  storeId           String
  date              String   // YYYY-MM-DD
  gmv               Float
  orderCount        Int
  conversionRate    Float
  averageOrderValue Float
  // Cancellations and refunds come from a different Seller Center series than the GMV
  // above, so they are nullable: a day fetched before this existed has no figure, and
  // that is not the same as a day with none.
  cancelledOrders     Int?
  cancelledSales      Float?
  returnRefundOrders  Int?
  returnRefundSales   Float?
  createdAt         DateTime @default(now())

  @@unique([storeId, date])
}

model ShopeeAdsData {
  id          String   @id @default(uuid())
  storeId     String
  date        String   // YYYY-MM-DD
  spend       Float
  sales       Float
  roas        Float
  impressions Int
  clicks      Int
  ctr         Float
  orders      Int      @default(0)
  itemSold    Int      @default(0)
  rawSpend    Float    @default(0)
  rawSales    Float    @default(0)
  rawVoucherSpend Float @default(0)
  rawVoucherSales Float @default(0)
  amountDivisor Int   @default(100000)
  voucherSpend Float  @default(0)
  voucherSales Float  @default(0)
  dataAsOf    DateTime @default(now())
  createdAt   DateTime @default(now())

  @@unique([storeId, date])
}

model ShopeeAdsCampaignSnapshot {
  id                String   @id @default(uuid())
  storeId           String
  campaignId        String
  date              String
  name              String
  type              String
  state             String
  dailyBudget       Float    @default(0)
  spend             Float    @default(0)
  sales             Float    @default(0)
  rawSpend          Float    @default(0)
  rawSales          Float    @default(0)
  rawDailyBudget    Float    @default(0)
  amountDivisor     Int      @default(100000)
  impressions       Int      @default(0)
  clicks            Int      @default(0)
  ctr               Float    @default(0)
  roas              Float    @default(0)
  voucherSpend      Float    @default(0)
  voucherSales      Float    @default(0)
  rawVoucherSpend   Float    @default(0)
  rawVoucherSales   Float    @default(0)
  dataAsOf          DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([storeId, campaignId, date])
  @@index([storeId, date])
}

model ProductMetricSnapshot {
  id                   String   @id @default(uuid())
  storeId              String
  shopeeItemId         String
  date                 String
  productName          String
  category             String   @default("Uncategorized")
  impressions          Int      @default(0)
  views                Int      @default(0)
  visitors             Int      @default(0)
  clicks               Int      @default(0)
  ctr                  Float    @default(0)
  bounceRate           Float    @default(0)
  addToCartBuyers      Int      @default(0)
  addToCartUnits       Int      @default(0)
  confirmedOrders      Int      @default(0)
  confirmedUnits       Int      @default(0)
  confirmedBuyers      Int      @default(0)
  confirmedSales       Float    @default(0)
  conversionRate       Float    @default(0)
  dataAsOf             DateTime @default(now())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([storeId, shopeeItemId, date])
  @@index([storeId, date])
}

model WarehouseLocation {
  id          Int      @id
  name        String
  code        String?
  ownerName   String?
  ownerEmail  String?
  teamId      Int?
  racksCount  Int      @default(0)
  racks       String?
  lastUpdated DateTime @default(now())
}

model WarehouseItem {
  id                String   @id @default(uuid())
  sku               String
  name              String
  size              String
  color             String
  totalStock        Int
  reservedStock     Int
  availableStock    Int
  imageUrl          String?
  location          String   @default("UNASSIGNED")
  warehouseId       Int?
  warehouseName     String?
  warehouseLocation String?
  stockSource       String   @default("WAREHOUSE_API")
  teamId            Int?
  teamName          String?
  teamCode          String?
  productType       String   @default("general")
  priceMin          Float?
  priceMax          Float?
  category          String?
  refId             String?
  desc              String?
  bundleCount       Int?
  isPriority        Boolean  @default(false)
  isCrossLocked     Boolean  @default(false)
  rawProductId      Int?
  rawVariationId    Int?
  lastUpdated       DateTime @default(now())
  // Sidik jari isi baris (lihat src/utils/rowHash.js). Sync hanya mengirim baris yang
  // sidik jarinya berbeda; baris lama yang belum punya nilai ini ikut ditulis sekali.
  contentHash       String?

  @@index([productType])
  @@index([teamId])
  @@index([warehouseId])
  @@index([rawVariationId])
  @@unique([sku, warehouseId])
  @@index([sku, warehouseId])
  @@index([rawVariationId, warehouseId])
}

model WarehouseStockSnapshot {
  id             String   @id @default(uuid())
  sku            String
  date           String
  name           String
  totalStock     Int      @default(0)
  reservedStock  Int      @default(0)
  availableStock Int      @default(0)
  warehouseId   Int?
  warehouseName  String?
  teamId         Int?
  teamName       String?
  productType    String?  @default("general")
  source         String   @default("WAREHOUSE_API")
  dataAsOf       DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  // Sidik jari isi baris (lihat src/utils/rowHash.js), tujuannya sama seperti di WarehouseItem.
  contentHash    String?

  @@unique([sku, warehouseId, date])
  @@index([date])
  @@index([productType])
  @@index([warehouseId])
}

model StockMovement {
  id            String   @id @default(uuid())
  sku           String
  productId     Int?
  productName   String
  type          String   // IN, OUT, ADJUSTMENT
  quantity      Int
  previousStock Int?
  currentStock  Int?
  reference     String?
  source        String   @default("PDC_GUDANG")
  note          String?
  warehouseId   Int?
  warehouseName String?
  timestamp     DateTime @default(now())

  @@index([sku])
  @@index([timestamp])
  @@index([type])
}

/// A Shopee sellable unit, and the warehouse items it is assembled from.
///
/// Measured against the real catalog, a Shopee listing is a SET and a warehouse item is
/// a COMPONENT: "3 In 1 Setelan | Blouse + Rok + Hijab" is sold as one listing but
/// stocked as three separate SKUs. Name matching between the two sides returns zero
/// results, so the relationship has to be recorded rather than inferred.
///
/// Mapping is anchored on the Shopee side because that list is finite - tens of
/// listings, not the 26k warehouse SKUs, most of which are never sold individually.
model ProductMapping {
  id            String   @id @default(uuid())
  storeId       String
  shopeeItemId  String
  /// Empty string means the mapping covers the whole listing rather than one variation.
  /// A sentinel rather than null because SQLite treats nulls as distinct in a unique
  /// index, so a nullable column here would let the same listing be mapped twice.
  shopeeModelId String   @default("")
  label         String   @default("")
  /// Set false instead of deleting, so reconciliation history keeps its referent.
  isActive      Boolean  @default(true)
  notes         String?
  mappedBy      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  components ProductMappingComponent[]

  @@unique([shopeeItemId, shopeeModelId])
  @@index([storeId, isActive])
}

/// One warehouse SKU inside a set, and how many of it each sale consumes.
///
/// Sellable stock for the set is min(floor(component stock / quantityPerUnit)) across
/// its components - the set runs out as soon as any one component does.
model ProductMappingComponent {
  id              String   @id @default(uuid())
  mappingId       String
  sku             String
  /// 0 means "any warehouse", i.e. sum stock across all of them. A sentinel rather
  /// than null for the same reason as shopeeModelId above - nulls would not collide,
  /// so the same component could be added to a set repeatedly.
  warehouseId     Int      @default(0)
  quantityPerUnit Int      @default(1)
  createdAt       DateTime @default(now())

  mapping ProductMapping @relation(fields: [mappingId], references: [id], onDelete: Cascade)

  @@unique([mappingId, sku, warehouseId])
  @@index([sku])
}

model StockReconciliation {
  id             String   @id @default(uuid())
  sku            String
  warehouseId    Int?
  warehouseName  String?
  shopeeStock    Int
  warehouseStock Int
  variance       Int
  status         String   // MATCHED, DISCREPANCY, CRITICAL
  checkedAt      DateTime @default(now())

  @@index([sku, warehouseId, checkedAt])
}

model SyncJobLog {
  id        String   @id @default(uuid())
  jobType   String   // SHOPEE_SYNC, WAREHOUSE_SYNC, RECONCILIATION
  status    String   // SUCCESS, DEGRADED, FAILED, RUNNING
  message   String
  timestamp DateTime @default(now())
}

model SyncRunLock {
  key        String   @id
  owner      String
  acquiredAt DateTime
  expiresAt  DateTime

  @@index([expiresAt])
}

model SystemConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model OptimizationTask {
  id               String   @id @default(uuid())
  recommendationId String
  type             String
  title            String
  description      String
  source           String   @default("SYSTEM")
  entityType       String   @default("PRODUCT")
  entityId         String?
  priority         String   @default("MEDIUM")
  status           String   @default("PROPOSED")
  createdById      String?
  createdByName    String?
  updatedById      String?
  updatedByName    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  completedAt      DateTime?
  events           OptimizationTaskEvent[]

  @@index([status, priority])
  @@index([entityType, entityId])
  @@index([recommendationId])
}

model OptimizationTaskEvent {
  id          String           @id @default(uuid())
  taskId      String
  task        OptimizationTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  status      String
  note        String?
  actorId     String?
  actorName   String?
  createdAt   DateTime         @default(now())

  @@index([taskId, createdAt])
}

model RegistrationCode {
  id            String    @id @default(uuid())
  code          String    @unique
  role          String    @default("USER") // ADMIN, USER
  maxUses       Int       @default(1) // 0 untuk unlimited, >= 1 untuk batas jumlah penggunaan
  usedCount     Int       @default(0)
  isActive      Boolean   @default(true)
  expiresAt     DateTime?
  description   String?
  createdById   String?
  createdByName String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([code, isActive])
  @@index([role])
}

model AdminAuditLog {
  id         String   @id @default(uuid())
  action     String   // USER_DELETE, ROLE_CHANGE, CODE_GENERATE, PASSWORD_RESET, USER_CREATE, SETTINGS_UPDATE
  details    String?  // Keterangan detail / payload json
  targetId   String?
  targetName String?
  actorId    String?
  actorName  String?
  actorEmail String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([action, createdAt])
  @@index([actorId])
}

