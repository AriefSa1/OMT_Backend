# Environment Variables for Shopee & Warehouse Analytics Backend

# Server Port (Render sets this dynamically, default: 5000)
PORT=5000

# Node Environment ('development' or 'production')
NODE_ENV=production

# Database URL (SQLite default or PostgreSQL connection string)
DATABASE_URL="file:./dev.db"

# JWT Secret Key for Authentication Tokens
JWT_SECRET=your_jwt_secret_key_here

# Optional: Google Gemini API Key for AI Optimization features
GEMINI_API_KEY=

# Optional: local Nous Research Hermes Agent API server
# Start Hermes with `hermes gateway`; the default API is http://127.0.0.1:8642/v1
HERMES_AGENT_ENABLED=false
HERMES_AGENT_BASE_URL=http://127.0.0.1:8642/v1
HERMES_AGENT_API_KEY=
HERMES_AGENT_MODEL=hermes-agent
HERMES_AGENT_TIMEOUT_MS=120000
# Set true untuk mencetak isi mentah model saat output ditolak validator evidence
# (diagnosa kegagalan kontrak analisa). Biarkan false di produksi.
HERMES_DEBUG=false

# Optional: max parallel page reads when aggregating Shopee Product Performance KPI
# totals across all result pages. Higher = faster on large catalogs, but more likely
# to hit Seller Center rate limits. Default 4.
SHOPEE_PRODUCT_PERFORMANCE_CONCURRENCY=4

# Admin API Key — protects /api/shopee/admin/* (Shopee cookie management).
# Sent by the admin as: Authorization: Bearer <ADMIN_API_KEY>. Never expose to the frontend.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=

# Encryption key for Shopee cookies at rest (AES-256-GCM). 32 bytes as 64 hex chars (or base64).
# Do NOT rotate once credentials are stored, or existing ciphertext becomes undecryptable.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_ENC_KEY=

# DEV ONLY — auto-login bypass. Bila '1' DAN NODE_ENV != production, request tanpa token
# diperlakukan sebagai admin default (memudahkan pengembangan lokal). WAJIB kosong/tidak
# diset di produksi. Ganda-terkunci: di NODE_ENV=production bypass tetap MATI meski diset.
# DEV_AUTH_BYPASS=1

# Optional tuning — outbound Shopee request pacing / retries (defaults are safe):
# SHOPEE_MIN_INTERVAL_MS=800      # jarak minimum antar-request keluar
# SHOPEE_JITTER_MS=400            # jitter acak ditambahkan ke jarak di atas
# SHOPEE_MAX_RETRIES=3            # jumlah retry untuk 429/5xx/error jaringan
# SHOPEE_BASE_BACKOFF_MS=1000     # basis backoff eksponensial
# SHOPEE_MAX_BACKOFF_MS=15000     # batas atas backoff
# ADMIN_RATE_LIMIT_MAX=30         # request admin / 5 menit / IP
