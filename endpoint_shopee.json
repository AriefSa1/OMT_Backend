      "name": "Dashboard Key Metrics",
      "category": "Bisnis Saya - Datacenter",
      "method": "GET",
      "base_url": "https://seller.shopee.co.id",
      "path": "/api/mydata/v3/dashboard/key-metrics/",
      "description": "Mengambil ringkasan metrik performa utama toko (Total Penjualan, Pesanan, Tingkat Konversi, Total Pengunjung, dan Halaman Dilihat).",
      "search_params": {
        "start_time": {
          "type": "integer (unix timestamp)",
          "description": "Waktu awal filter data dalam detik",
          "example": 1720137600
        },
        "end_time": {
          "type": "integer (unix timestamp)",
          "description": "Waktu akhir filter data dalam detik",
          "example": 1722729600
        },
        "period": {
          "type": "string",
          "enum": ["past30days", "past7days", "realtime", "month"],
          "description": "Rentang periode data analitik",
          "example": "past30days"
        },
        "fetag": {
          "type": "string",
          "description": "Frontend tracking tag",
          "example": "datacenter_overview"
        }
      },
      "request_payload": null
    },
